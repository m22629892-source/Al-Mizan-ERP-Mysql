{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build",
    "start": "node --import tsx server.ts",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx src/server/run-tests-cli.ts",
    "test:security": "node --import tsx src/server/verify-security-suite.ts",
    "test:ops": "node --import tsx src/server/verify-operations.ts",
    "test:all": "node --import tsx src/server/run-tests-cli.ts && node --import tsx src/server/verify-security-suite.ts && node --import tsx src/server/verify-operations.ts && npm run test:mysql",
    "db:init": "node --import tsx scripts/init-mysql.ts",
    "db:check": "node --import tsx scripts/check-mysql.ts",
    "db:migrate-sqlite": "node --import tsx scripts/migrate-sqlite.ts",
    "test:mysql": "node --import tsx src/server/verify-mysql.ts"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
