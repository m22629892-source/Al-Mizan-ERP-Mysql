# Copy this file to .env. Enter the MySQL user/password you created in Workbench.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=almizan
MYSQL_USER=almizan_app
MYSQL_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
MYSQL_POOL_SIZE=10
PORT=4000
NODE_ENV=development
# Demo is created explicitly with: npm run db:init -- --demo
SEED_DEMO_DATA=false
